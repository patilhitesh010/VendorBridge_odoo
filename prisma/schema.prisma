generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  role         Role
  name         String
  createdAt    DateTime   @default(now())
  rfqs         RFQ[]
  auditLogs    AuditLog[]
}

enum Role {
  ADMIN
  OFFICER
  MANAGER
  VENDOR
}

model Vendor {
  id             String          @id @default(cuid())
  name           String
  categories     String[]
  gstNumber      String          @unique
  stateCode      String
  contactPerson  String?
  email          String?
  phone          String?
  panNumber      String?
  bankAccountNo  String?
  ifscCode       String?
  status         VendorStatus    @default(ACTIVE)
  vtsScore       Float           @default(50)
  quotations     Quotation[]
  approvals      Approval[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

model RFQ {
  id          String      @id @default(cuid())
  rfqNumber   String      @unique
  title       String
  description String?
  lineItems   Json
  deadline    DateTime
  status      RFQStatus   @default(DRAFT)
  vendorIds   String[]
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  quotations  Quotation[]
  approvals   Approval[]
  createdAt   DateTime    @default(now())
}

enum RFQStatus {
  DRAFT
  PUBLISHED
  UNDER_REVIEW
  CLOSED
}

model Quotation {
  id             String          @id @default(cuid())
  rfqId          String
  rfq            RFQ             @relation(fields: [rfqId], references: [id])
  vendorId       String
  vendor         Vendor          @relation(fields: [vendorId], references: [id])
  lineItemPrices Json
  grandTotal     Float
  deliveryDate   DateTime
  terms          String?
  status         QuotationStatus @default(DRAFT)
  submittedAt    DateTime?
  approvals      Approval[]
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SELECTED
  REJECTED
}

model Approval {
  id          String         @id @default(cuid())
  rfqId       String
  rfq         RFQ            @relation(fields: [rfqId], references: [id])
  quotationId String
  quotation   Quotation      @relation(fields: [quotationId], references: [id])
  vendorId    String
  vendor      Vendor         @relation(fields: [vendorId], references: [id])
  status      ApprovalStatus @default(PENDING)
  steps       ApprovalStep[]
  createdAt   DateTime       @default(now())
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalStep {
  id         String     @id @default(cuid())
  approvalId String
  approval   Approval   @relation(fields: [approvalId], references: [id])
  approverId String
  level      Int
  action     StepAction @default(PENDING)
  remarks    String?
  actionAt   DateTime?
}

enum StepAction {
  PENDING
  APPROVED
  REJECTED
  ESCALATED
}

model PurchaseOrder {
  id           String    @id @default(cuid())
  poNumber     String    @unique
  approvalId   String
  vendorId     String
  vendor       Vendor    @relation(fields: [vendorId], references: [id])
  lineItems    Json
  deliveryDate DateTime
  status       POStatus  @default(ISSUED)
  invoices     Invoice[]
  issuedAt     DateTime  @default(now())
}

enum POStatus {
  ISSUED
  ACKNOWLEDGED
  CLOSED
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  poId          String
  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id])
  vendorId      String
  vendor        Vendor        @relation(fields: [vendorId], references: [id])
  lineItems     Json
  subtotal      Float
  cgst          Float         @default(0)
  sgst          Float         @default(0)
  igst          Float         @default(0)
  grandTotal    Float
  status        InvoiceStatus @default(DRAFT)
  issuedAt      DateTime      @default(now())
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  SENT
  PAID
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  prevState  String?
  newState   String?
  metadata   Json?
  createdAt  DateTime @default(now())
}
